{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmsh-engineering-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "EngineeringCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EngineeringCoordinator"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "REPOSITORY": "kmshdev/foundation-models-utilities",
    "LINEAR_PROJECT_NAME": "Engineering Workflow Automation",
  },
}
